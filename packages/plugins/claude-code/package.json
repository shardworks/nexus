{
  "name": "@shardworks/claude-code-apparatus",
  "version": "0.0.0",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/shardworks/nexus",
    "directory": "packages/plugins/claude-code"
  },
  "description": "Claude Code session provider apparatus — launches claude sessions via the Animator",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./babysitter": "./src/babysitter.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@shardworks/nexus-core": "0.x"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@shardworks/animator-apparatus": "workspace:*",
    "@shardworks/stacks-apparatus": "workspace:*",
    "@shardworks/tools-apparatus": "workspace:*",
    "better-sqlite3": "12.8.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@shardworks/nexus-core": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.5.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./babysitter": {
        "types": "./dist/babysitter.d.ts",
        "import": "./dist/babysitter.js"
      }
    }
  }
}