    "test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test 'src/**/*.test.ts' 'pages/**/*.test.js'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@shardworks/nexus-core": "0.x"
  },
  "dependencies": {
    "@shardworks/stacks-apparatus": "workspace:*",
    "@shardworks/tools-apparatus": "workspace:*",
    "@shardworks/clerk-apparatus": "workspace:*",
    "@shardworks/spider-apparatus": "workspace:*",
    "@shardworks/fabricator-apparatus": "workspace:*",
    "@shardworks/loom-apparatus": "workspace:*",
    "@shardworks/animator-apparatus": "workspace:*",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@shardworks/nexus-core": "workspace:*",
    "@types/node": "25.5.0"
  },
  "files": [
    "dist",
    "sage-primer-reader.md",
    "sage-primer-scoping.md",
    "sage-writer.md",
    "sage-primer-solo.md",
    "sage-primer-attended.md",
    "patron-anima-prompt.md",
    "pages"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}