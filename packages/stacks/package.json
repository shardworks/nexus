{
  "name": "@shardworks/stacks",
  "version": "0.0.0",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/shardworks/nexus",
    "directory": "packages/stacks"
  },
  "description": "The Stacks — guild persistence apparatus (NoSQL document store with CDC)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/memory-backend.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shardworks/nexus-core": "workspace:*",
    "better-sqlite3": "12.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.5.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/memory-backend.d.ts",
        "import": "./dist/memory-backend.js"
      }
    }
  }
}
